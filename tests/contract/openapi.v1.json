    "/healthz": {
      "get": {
        "description": "Unauthenticated liveness check used by Fly.\n\nReturns the git SHA baked in at build time so the deploy job can prove the\nlive service is the commit it just shipped \u2014 a green gate and a changed\nservice are different claims (PharmFoldMDK lesson 3.4). A commit SHA is\npublic on GitHub already; it reveals nothing new.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "ops"
        ]
      }
    },
